# ─────────────────────────────────────────────────────────────────────
# Variables de entorno del ecosistema CFO VICOMER
# En la nube: cárgalas en el environment de Claude Code (Edit environment
# → Environment variables). NUNCA pegues valores reales en este archivo
# ni en el chat. Este archivo es solo la plantilla.
# ─────────────────────────────────────────────────────────────────────

# ── Odoo principal (Ecuador + Colombia + Costa Rica, desde abr/ago-2026)
ODOO_URL=https://vicomer.odoo.com
ODOO_DB=intitecnologia-v-comer-main-27740127
ODOO_LOGIN=jmvidal@v-comer.com
ODOO_APIKEY=

# ── Odoo histórico Colombia (vintral1, jun-2025 a mar-2026) — solo Casa Magna sell-in
ODOO_APIKEY_VINTRAL1=

# ── Perseo (Ecuador hasta jul-2026) — solo consultas históricas
# API: POST https://perseo-data-c1.app/api/facturas_consulta
PERSEO_API_KEY=

# ── Correo saliente (Gmail con App Password de jmvidal@v-comer.com)
SMTP_USER=jmvidal@v-comer.com
SMTP_APP_PASSWORD=
GMAIL_APP_PASSWORD=

# ── Rutas (cloud/setup.sh las fija solo; aquí por referencia)
# VICOMER_PROJ=<raíz del repo>
# ODOO_OUT_DIR=<raíz>/OdooVentas
# PERSEO_FILES_DIR=<raíz>/data/presupuesto     # libros Excel de presupuesto (bajados de Drive)
# VICOMER_PERSONAL=<raíz>/data/personal        # presupuesto de gastos (bajado de Drive)

# ── Modos de prueba (no envían correo)
# CASAMAGNA_DRYRUN=1
# PERSEO_MAIL_DRYRUN=1
